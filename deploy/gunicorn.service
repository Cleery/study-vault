[Unit]
Description=Math Question Bank Gunicorn
After=network.target

[Service]
Type=simple
User=mathvault
Group=www-data
WorkingDirectory=/srv/math-question-bank/current
EnvironmentFile=/etc/math-question-bank.env
RuntimeDirectory=math-question-bank
RuntimeDirectoryMode=0750
UMask=0027
ExecStartPre=/srv/math-question-bank/venv/bin/python deploy/check-production-config.py
ExecStart=/srv/math-question-bank/venv/bin/gunicorn --workers 1 --timeout 120 --bind unix:/run/math-question-bank/gunicorn.sock --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/math-question-bank/shared

[Install]
WantedBy=multi-user.target
