SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=false
DEV_AUTH_BYPASS=false
ALLOWED_HOSTS=example.com
TIME_ZONE=Asia/Shanghai
DATABASE_PATH=/srv/math-question-bank/shared/db.sqlite3
MEDIA_ROOT=/srv/math-question-bank/shared/media
STATIC_ROOT=/srv/math-question-bank/shared/static
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://example.com
SESSION_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
BACKUP_AGE_PUBLIC_KEY=age1replace-with-recipient-public-key
BACKUP_AGE_CLI=/usr/bin/age
BACKUP_OFFLINE_PATH=/mnt/offline/math-question-bank

# AI analysis is disabled by default. Fill these values only after reviewing
# the relay provider's privacy policy and image retention settings.
AI_ENABLED=false
AI_PROVIDER=relay
AI_BASE_URL=https://placeholder.example/v1
AI_API_KEY=
AI_VISION_MODEL=placeholder-vision-model
AI_ANALYSIS_MODEL=placeholder-analysis-model
AI_TIMEOUT_SECONDS=60
AI_TOTAL_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_RESPONSE_BYTES=2097152
AI_MAX_IMAGE_COUNT=20
AI_MAX_IMAGE_BYTES=41943040
AI_ALLOW_PRIVATE_BASE_URL=false
AI_RAW_RESPONSE_RETENTION_DAYS=30
AI_AUTO_LINK_THRESHOLD=0.90
AI_REVIEW_THRESHOLD=0.70
